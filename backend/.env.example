# Copy this file to "backend/.env" for local (non-Docker) development.
# For Docker deployment, use the root .env.example instead - docker-compose
# passes these values into the backend container directly.

NODE_ENV=development
PORT=3000

DB_USER=vision79
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vision79_siwm

# Generate with: node generate-secrets.cjs
JWT_SECRET=change-me-to-a-long-random-string

# Optional: Gemini AI features (chatbot, insights)
GEMINI_API_KEY=

# Optional: email notifications
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
